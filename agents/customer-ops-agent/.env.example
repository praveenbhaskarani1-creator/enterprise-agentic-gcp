# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Agent Platform RAG Engine
RAG_LOCATION=us-central1
RAG_CORPUS_RESOURCE=
RAG_TOP_K=3
# Multi-agent runtime mode:
# combined, customer_data, policy, or supervisor
AGENT_ROLE=combined

# Required only when AGENT_ROLE=supervisor
CUSTOMER_DATA_AGENT_CARD_URL=http://127.0.0.1:18081/a2a/app/.well-known/agent-card.json
POLICY_AGENT_CARD_URL=http://127.0.0.1:18082/a2a/app/.well-known/agent-card.json